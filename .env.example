# Copy to .env and fill in. .env is gitignored — never paste values in chat.

# Supabase (Project Settings › API) — publishable/anon key only, never service_role
SUPABASE_URL=
SUPABASE_KEY=

# The only account allowed in (sign-ups are off in Supabase) — ADR-0006
OWNER_EMAIL=

# Postgres via pooler (Connect › Connection String › Method)
# transaction pooler :6543 for the app, session pooler :5432 for drizzle-kit migrate
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Vault master key (ADR-0002) — base64 of 32 random bytes: `openssl rand -base64 32`
# keep a copy outside Vercel; losing it makes every stored Key unreadable
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_VERSION=

# Ranker: thai-dict (default) | keyword | claude | jev — see ADR-0003
RANKER=

# Jev / TypeSafe — sign-ups closed as of 2026-09-23; leave empty until a key exists
TYPESAFE_API_KEY=
