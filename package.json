{
  "name": "api-vault",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "check": "npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:import": "tsx --env-file=.env scripts/import-entries.ts",
    "db:verify": "tsx --env-file=.env scripts/db-verify.ts",
    "demo:build": "tsx --env-file=.env scripts/build-demo.ts",
    "eval:ranker": "tsx scripts/eval-ranker.ts",
    "postbuild": "tsx scripts/scan-build.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/supabase": "^2.0.10",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "version": "0.5.1",
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
